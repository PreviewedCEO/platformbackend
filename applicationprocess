const express = require("express");
const bodyParser = require("body-parser");
const { MongoClient } = require("mongodb");

const app = express();
app.use(bodyParser.json());

// Initialize MongoDB client
const uri = "mongodb://localhost:27017";
const client = new MongoClient(uri, { useUnifiedTopology: true });

async function main() {
  try {
    // Connect to the MongoDB server
    await client.connect();

    // Get the database and collections
    const db = client.db("previewed_db");
    const jobSeekers = db.collection("job_seekers");
    const jobListings = db.collection("job_listings");
    const jobApplications = db.collection("job_applications");

    // Endpoint for job seeker application
    app.post("/apply", async (req, res) => {
      // Get job seeker data from request body
      const jobSeekerData = req.body;

      // Check if job seeker already has an account
      let jobSeeker = await jobSeekers.findOne({ email: jobSeekerData.email });

      if (!jobSeeker) {
        // Create new job seeker account if not found
        jobSeeker = {
          name: jobSeekerData.name,
          email: jobSeekerData.email,
          resume: jobSeekerData.resume,
          // Add additional job seeker information as needed
        };
        await jobSeekers.insertOne(jobSeeker);
      }

      // Get job listing from request body
      const jobListing = await jobListings.findOne({ _id: jobSeekerData.job_id });

      // Create new job application
      const jobApplication = {
        job_id: jobListing._id,
        job_title: jobListing.title,
        job_company: jobListing.company,
        job_location: jobListing.location,
        job_description: jobListing.description,
        job_questions: jobListing.questions,
        job_seeker_id: jobSeeker._id,
        job_seeker_name: jobSeeker.name,
        job_seeker_email: jobSeeker.email,
        job_seeker_resume: jobSeeker.resume,
        job_answers: jobSeekerData.answers,
      };
      await jobApplications.insertOne(jobApplication);

      // Send confirmation response
      res.json({ message: "Job application submitted successfully!" });
    });

    // Start the Express server
    app.listen(3000, () => {
      console.log("Server started on port 3000");
    });
  } catch (error) {
    console.error("Error connecting to MongoDB:", error);
  }
}

main();
